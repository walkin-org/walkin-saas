PORT=3000
# Set these before first sign-in. Choose a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# URL collectors can reach (use your HTTPS origin for remote users)
APP_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DATA_DIR=data
# Amazon RDS PostgreSQL (URL-encode username and password)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/walkin?sslmode=verify-full
# NODE_EXTRA_CA_CERTS=C:/certificates/rds-global-bundle.pem
# Legacy S3/R2 source for importing existing storefront photos on startup
# S3_BUCKET=walkin-media
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
